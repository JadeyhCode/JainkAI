任务:最大公约数	用途	求两个数的最大公约数
骨架:最大公约数	语言	C11
骨架:最大公约数	依赖	stdio.h
骨架:最大公约数	代码	#include <stdio.h>\
static long gcd(long a, long b) { while (b) { long t = a % b; a = b; b = t; } return a < 0 ? -a : a; }\
int main(void) {\
    printf("%ld\n", gcd(48, 18));\
    int ok = gcd(48,18) == 6 && gcd(17,5) == 1 && gcd(0,9) == 9 && gcd(100,75) == 25;\
    printf("%s\n", ok ? "ok gcd" : "FAIL gcd");\
    return ok ? 0 : 1;\
}
任务:字符统计	关键词	字符统计
任务:字符统计	关键词	字母
任务:字符统计	关键词	数字个数
任务:字符统计	骨架	骨架:字符统计
任务:字符统计	用途	统计字符串里的字母/数字/空格/其他字符个数
骨架:字符统计	语言	C11
骨架:字符统计	依赖	stdio.h
骨架:字符统计	代码	#include <stdio.h>\
int main(void) {\
    const char *s = "Hello 42 world!";\
    int letters = 0, digits = 0, spaces = 0, other = 0;\
    for (const char *p = s; *p; p++) {\
        if ((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')) letters++;\
        else if (*p >= '0' && *p <= '9') digits++;\
        else if (*p == ' ') spaces++;\
        else other++;\
    }\
    printf("letters=%d digits=%d spaces=%d other=%d\n", letters, digits, spaces, other);\
    int ok = letters == 10 && digits == 2 && spaces == 2 && other == 1;\
    printf("%s\n", ok ? "ok chars" : "FAIL chars");\
    return ok ? 0 : 1;\
}
