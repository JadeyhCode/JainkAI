任务:最值平均	用途	读 N 个整数（stdin），输出 max/min/avg
骨架:最值平均	语言	C11
骨架:最值平均	依赖	stdio.h
骨架:最值平均	代码	#include <stdio.h>\
int main(void) {\
    long v[64];\
    int n = 0;\
    while (n < 64 && scanf("%ld", &v[n]) == 1) n++;\
    long sample[5] = {3,1,4,1,5};\
    if (n <= 0) { for (int i = 0; i < 5; i++) v[i] = sample[i]; n = 5; }\
    long mx = v[0], mn = v[0];\
    double sum = 0;\
    for (int i = 0; i < n; i++) { if (v[i] > mx) mx = v[i]; if (v[i] < mn) mn = v[i]; sum += v[i]; }\
    printf("max=%ld min=%ld avg=%.2f\n", mx, mn, sum / n);\
    long t[5] = {3,1,4,1,5}, tmx = 5, tmn = 1; double ts = 14;\
    long gmx = t[0], gmn = t[0]; double gs = 0;\
    for (int i = 0; i < 5; i++) { if (t[i] > gmx) gmx = t[i]; if (t[i] < gmn) gmn = t[i]; gs += t[i]; }\
    int ok = (gmx == tmx && gmn == tmn && gs == ts) && n > 0;\
    printf("%s\n", ok ? "ok stats" : "FAIL stats");\
    return ok ? 0 : 1;\
}
任务:二分查找	关键词	二分
任务:二分查找	关键词	查找
任务:二分查找	骨架	骨架:二分查找
任务:二分查找	用途	有序数组里找 key，输出下标或 -1
骨架:二分查找	语言	C11
骨架:二分查找	依赖	stdio.h
骨架:二分查找	代码	#include <stdio.h>\
static int bsearch_int(const int *a, int n, int key) {\
    int lo = 0, hi = n - 1;\
    while (lo <= hi) { int mid = lo + (hi - lo) / 2; if (a[mid] == key) return mid; if (a[mid] < key) lo = mid + 1; else hi = mid - 1; }\
    return -1;\
}\
int main(void) {\
    int a[6] = {1,3,5,7,9,11}, n = 6, k;\
    if (scanf("%d", &k) != 1) k = 7;\
    printf("%d\n", bsearch_int(a, n, k));\
    int ok = bsearch_int(a, n, 7) == 3 && bsearch_int(a, n, 4) == -1 && bsearch_int(a, n, 1) == 0;\
    printf("%s\n", ok ? "ok bsearch" : "FAIL bsearch");\
    return ok ? 0 : 1;\
}
