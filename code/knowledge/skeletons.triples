任务:进制转换	骨架	骨架:进制转换
任务:进制转换	用途	十进制转二/十六进制
骨架:进制转换	语言	C11
骨架:进制转换	依赖	stdio.h string.h
骨架:进制转换	代码	#include <stdio.h>\
#include <string.h>\
static void to_base(long n, int base, char *out) {\
    const char *digits = "0123456789abcdef";\
    char tmp[65];\
    int i = 0;\
    if (n == 0) tmp[i++] = '0';\
    while (n > 0) { tmp[i++] = digits[n % base]; n /= base; }\
    for (int j = 0; j < i; j++) out[j] = tmp[i-1-j];\
    out[i] = 0;\
}\
int main(void) {\
    char b[65];\
    to_base(13, 2, b); printf("%s\n", b);\
    int ok = 1;\
    to_base(13, 2, b); if (strcmp(b, "1101")) ok = 0;\
    to_base(255, 16, b); if (strcmp(b, "ff")) ok = 0;\
    to_base(0, 2, b); if (strcmp(b, "0")) ok = 0;\
    printf("%s\n", ok ? "ok base" : "FAIL base");\
    return ok ? 0 : 1;\
}
