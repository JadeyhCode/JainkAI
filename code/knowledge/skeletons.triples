任务:单词计数	关键词	wc
任务:单词计数	骨架	骨架:单词计数
任务:单词计数	用途	统计文件的行/词/字符数（类似 wc）
骨架:单词计数	语言	C11
骨架:单词计数	依赖	stdio.h
骨架:单词计数	代码	#include <stdio.h>\
int main(int argc, char **argv) {\
    const char *fn = argc > 1 ? argv[1] : "/etc/hostname";\
    FILE *f = fopen(fn, "rb");\
    if (!f) { printf("%s\n", "FAIL open"); return 1; }\
    long lines = 0, words = 0, chars = 0;\
    int c, inw = 0;\
    while ((c = fgetc(f)) != EOF) {\
        chars++;\
        if (c == '\n') lines++;\
        if (c == ' ' || c == '\n' || c == '\t') inw = 0;\
        else if (!inw) { inw = 1; words++; }\
    }\
    fclose(f);\
    printf("%ld %ld %ld\n", lines, words, chars);\
    FILE *g = fopen(fn, "rb");\
    long self_lines = 0;\
    if (g) { int d; while ((d = fgetc(g)) != EOF) if (d == '\n') self_lines++; fclose(g); }\
    int ok = lines == self_lines && chars > 0 && words > 0;\
    printf("%s\n", ok ? "ok wc" : "FAIL wc");\
    return ok ? 0 : 1;\
}
任务:冒泡排序	关键词	排序
任务:冒泡排序	关键词	冒泡
任务:冒泡排序	关键词	从小到大
任务:冒泡排序	骨架	骨架:冒泡排序
任务:冒泡排序	用途	读 N 个整数（或用样例），从小到大排序后输出
骨架:冒泡排序	语言	C11
骨架:冒泡排序	依赖	stdio.h
骨架:冒泡排序	代码	#include <stdio.h>\
static void bubble(int *a, int n) {\
    for (int i = 0; i < n - 1; i++)\
        for (int j = 0; j < n - 1 - i; j++)\
            if (a[j] > a[j+1]) { int t = a[j]; a[j] = a[j+1]; a[j+1] = t; }\
}\
int main(void) {\
    int a[6] = {5,2,9,1,5,6}, n = 6;\
    bubble(a, n);\
    for (int i = 0; i < n; i++) printf("%d%s", a[i], i + 1 < n ? " " : "\n");\
    int want[6] = {1,2,5,5,6,9}, ok = 1;\
    for (int i = 0; i < n; i++) if (a[i] != want[i]) ok = 0;\
    printf("%s\n", ok ? "ok sort" : "FAIL sort");\
    return ok ? 0 : 1;\
}
