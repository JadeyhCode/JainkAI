任务:素数	骨架	骨架:素数
任务:素数	用途	命令行给上限 N，逐行输出 2..N 的素数
骨架:素数	语言	C11
骨架:素数	依赖	stdio.h stdlib.h
骨架:素数	代码	#include <stdio.h>\
#include <stdlib.h>\
static int is_prime(long n) { if (n < 2) return 0; for (long i = 2; i * i <= n; i++) if (n % i == 0) return 0; return 1; }\
int main(int argc, char **argv) {\
    long N = argc > 1 ? atol(argv[1]) : 30, cnt = 0;\
    for (long i = 2; i <= N; i++) if (is_prime(i)) { printf("%ld\n", i); cnt++; }\
    printf("%s\n", is_prime(97) && !is_prime(91) ? "ok prime" : "FAIL prime");\
    printf("%s\n", cnt == 10 ? "ok count" : "FAIL count");\
    return (is_prime(97) && !is_prime(91) && cnt == 10) ? 0 : 1;\
}
